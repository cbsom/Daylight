# C++ Compiler Outputs & Libraries
# ==============================================================================
# Compiled Object files
*.o
*.obj
*.gch
*.pch

# Static and Dynamic Libraries
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# Debug symbols and databases
*.pdb
*.ilk
*.dSYM/
*.dwo

# Dependency files
*.d

# ==============================================================================
# Package Managers & Dependencies
# ==============================================================================
vcpkg_installed/
.vcpkg-root

