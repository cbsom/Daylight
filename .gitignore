# Generated builds (source lives under outputs/Earth-and-Sky/source).
[Bb]uild/
build-*/
cmake-build-*/
/out/
/bin/
[Dd]ebug/
[Rr]elease/
build-qt68/

# Local SDKs, downloaded tools, scratch files and test captures.
# Keep the small scripts needed to reproduce this project's build/setup.
/work/*
!/work/build.cmd
!/work/deploy.cmd
!/work/make-icon.cmd
!/work/install_qt.py

# Packaged binaries and generated previews; preserve source and documentation.
/outputs/Earth-and-Sky-Windows*.zip
/outputs/Earth-and-Sky/app/
/outputs/Earth-and-Sky/preview.png
/outputs/Earth-and-Sky/VALIDATION.md

# CMake-generated state. Shared CMakePresets.json remains trackable.
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/
Makefile
build.ninja
rules.ninja
.ninja_deps
.ninja_log
.qt/
.rcc/
*_autogen/

# Compiler, linker and runtime output.
*.o
*.obj
*.gch
*.pch
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.exp
*.idb
*.ipch
*.res
*.tlog
*.dSYM/
*.dwo
*.d

# Local dependency installations and Python caches.
vcpkg_installed/
__pycache__/
*.py[cod]
.venv/
venv/

# Track useful editor configuration; ignore local IDE state.
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
.vs/
.idea/
*.suo
*.user
CMakeLists.txt.user*

# Logs, editor backups and operating-system metadata.
*.log
*.tmp
*.bak
*~
.DS_Store
Thumbs.db
Desktop.ini

# Do not ignore source files, vendor/astronomy.*, image assets, app.rc,
# CMakeLists.txt, source/build.cmd, shared presets, READMEs or license notices.
