# ==============================================================================
# CMake Build Artifacts
# ==============================================================================
# Ignore the default and common build directories
[Bb]uild/
build-*/
/out/
/bin/
work/
work/Qt/

# Ignore generated release artifacts and installer logs
outputs/
aqtinstall.log

# Ignore CMake cache and generated configuration files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Makefile
_deps/

